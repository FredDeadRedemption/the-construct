// niri config for Matrix.
// This is a *user* file, not part of the NixOS config — niri reads it from
// ~/.config/niri/config.kdl and reloads it live on save.
// Check changes before saving over a working config:  niri validate

input {
    keyboard {
        xkb {
            layout "dk"
        }
        repeat-delay 400
        repeat-rate 40
    }

    touchpad {
        tap
        dwt
        natural-scroll
        accel-profile "adaptive"
    }

    mouse {
        accel-profile "flat"
    }
}

// Run `niri msg outputs` to see real names/modes, then uncomment.
output "eDP-1" {
    // scale 1.5
    // mode "2560x1600@165.000"
}

layout {
    gaps 12
    center-focused-column "never"

    // Mod+R cycles a column through these widths.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#6a9fb5"
        inactive-color "#6b6b6b"
    }

    border {
        off
    }
}

// niri is built without XWayland. xwayland-satellite supplies it as a side
// process so X11-only apps (Steam, older Electron, JetBrains) still run.
spawn-at-startup "xwayland-satellite"

spawn-at-startup "waybar"
spawn-at-startup "mako"

// niri paints only a solid backdrop, an image needs a separate program
spawn-at-startup "swaybg" "-i" "/home/fred/Pictures/wallpaper.jpg" "-m" "fill"

// keyboard rgb resets to rainbow on power cycle; 24 zones, order r1c1 to r4c6
spawn-at-startup "openrgb" "--device" "0" "--color" "FF0000,FF0000,FF0000,FF0000,FF0000,FF0000,FF0000,FF0000,FF0000,FF0000,FF0000,FF0000,6A9FB5,6A9FB5,6A9FB5,6A9FB5,6A9FB5,6A9FB5,6A9FB5,6A9FB5,6A9FB5,6A9FB5,6A9FB5,6A9FB5"

// separate watchers, cliphist stores text and images differently
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"

environment {
    DISPLAY ":0"
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

binds {
    // Mod is Super. Press Mod+Shift+/ for this list in-session.
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+T hotkey-overlay-title="Terminal" { spawn "alacritty"; }
    Mod+D hotkey-overlay-title="Run an application" { spawn "fuzzel"; }
    Mod+Alt+L hotkey-overlay-title="Lock the screen" { spawn "swaylock"; }
    // spawn takes no shell, so the pipeline runs under sh
    Mod+V hotkey-overlay-title="Clipboard history" { spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }

    Mod+Q { close-window; }

    // Focus. The scrollable strip runs left/right; windows stack up/down
    // inside a column.
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    // Move the focused window.
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // Workspaces are per-monitor and dynamic.
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }

    // Column and window sizing.
    Mod+R           { switch-preset-column-width; }
    Mod+Shift+R     { switch-preset-window-height; }
    Mod+F           { maximize-column; }
    Mod+Shift+F     { fullscreen-window; }
    Mod+C           { center-column; }
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Consume/expel windows into and out of the focused column.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Print { screenshot; }
    Print     { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Media and brightness keys. allow-when-locked so they work at the
    // lock screen.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    Mod+Shift+E { quit; }
}
